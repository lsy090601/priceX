# Supabase 대시보드 > Project Settings > API Keys 에서 복사하세요.
# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
#
# ⚠️ 앱 번들에 그대로 포함되는 값입니다.
#    publishable 키(sb_publishable_... 또는 레거시 anon 키)만 넣으세요.
#    secret 키(sb_secret_...) / service_role 키는 절대 넣지 마세요.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 소셜 로그인: Supabase 대시보드에서 제공자 설정을 끝낸 뒤 true 로 바꾸세요.
# false 인 동안에는 버튼을 눌러도 "준비 중" 안내만 표시됩니다.
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_KAKAO_ENABLED=false
